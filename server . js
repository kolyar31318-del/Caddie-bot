let isAvailable = true;

const CADDIE_KEYWORDS = [
  "caddie", "caddies", "caddy", "caddys",
  "loop", "loops", "need", "anyone", "available", "bag", "bags"
];

function isCaddieRequest(text) {
  const lower = text.toLowerCase();
  return CADDIE_KEYWORDS.some(kw => lower.includes(kw));
}

